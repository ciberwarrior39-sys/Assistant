<Project Sdk="Microsoft.NET.Sdk">

  <!-- The assistant's logic. No WPF here, so it stays testable and the UI stays swappable. -->
  <PropertyGroup>
    <RootNamespace>Assistant.Core</RootNamespace>
  </PropertyGroup>

  <!-- Everything SDK DLL: copy it into the repo's lib folder. It travels to the app's output from here. -->
  <ItemGroup>
    <None Include="..\..\lib\Everything64.dll" Link="Everything64.dll" Condition="Exists('..\..\lib\Everything64.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Voice (build step 8), all free and open source: microphone capture, local Whisper speech-to-text
       on the CPU, and Windows' own text-to-speech voices. NAudio stays on 2.2.1, whose API is known to work here. -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>

  <!-- Wake word (0.8): runs openWakeWord's small ONNX models on the CPU. Microsoft's ONNX Runtime, MIT licence. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <!-- Mail (0.8): a read-only look at the inbox over IMAP. MailKit, MIT licence. 4.16.0 or later: earlier versions
       have a known flaw in STARTTLS (this app uses SSL from the start, but stays on a fixed version anyway).
       The cryptography package is named to lift MimeKit's older copy, which also has known flaws. -->
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
  </ItemGroup>

  <!-- Setup (build step 10): cloud keys encrypted with Windows DPAPI, and Windows Search as the file-search
       fallback when Everything isn't installed. Both are Microsoft's own packages. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.12" />
  </ItemGroup>

</Project>
