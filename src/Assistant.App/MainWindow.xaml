<Window x:Class="Assistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant" Width="580" Height="680" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dependency status, plus a way to see everything the assistant stores -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Open data folder" Padding="8,2" Margin="6,0,0,0" Click="OnOpenDataFolder"/>
            <Button DockPanel.Dock="Right" Content="Recheck" Padding="8,2" Click="OnRecheck"/>
            <TextBlock x:Name="StatusText" Text="Checking..." Foreground="#555555"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl x:Name="Messages">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Foreground="#666666"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <!-- Files found by search_files, with real paths from the index -->
                                <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}"
                                                                   Foreground="#777777" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Modified, StringFormat='Modified {0:yyyy-MM-dd HH:mm}'}"
                                                                   Foreground="#777777" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Open" Padding="10,3" Margin="8,0,0,0"
                                                                Tag="{Binding FullPath}" Click="OnOpenFile"/>
                                                        <Button Content="Show in Explorer" Padding="10,3" Margin="6,0,0,0"
                                                                Tag="{Binding FullPath}" Click="OnRevealFile"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="BusyText" Grid.Row="2" Text="Thinking..." Foreground="#888888"
                   Margin="2,6,0,0" Visibility="Collapsed"/>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Padding="16,4"
                    Margin="8,0,0,0" IsDefault="True" Click="OnSend"/>
            <TextBox x:Name="Input" Padding="6,4" VerticalContentAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
