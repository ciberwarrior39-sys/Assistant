<Window x:Class="Assistant.App.ChatBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Assistant.App"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Assistant" Width="400" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" FontSize="13"
        Foreground="{DynamicResource Text}">

    <!-- Theme: the light defaults. ApplyAppearance swaps these for the dark theme and the chosen text size. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="White"/>
        <SolidColorBrush x:Key="Edge" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="Text" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Muted" Color="#6B6B6B"/>
        <SolidColorBrush x:Key="CardEdge" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="ReviewSurface" Color="#FFF9EC"/>
        <SolidColorBrush x:Key="ReviewEdge" Color="#E8C77A"/>
        <SolidColorBrush x:Key="Note" Color="#2E8B57"/>
        <SolidColorBrush x:Key="InputSurface" Color="White"/>
        <sys:Double x:Key="SmallSize">11</sys:Double>
        <sys:Double x:Key="LabelSize">12</sys:Double>
        <sys:Double x:Key="TitleSize">14</sys:Double>
    </Window.Resources>

    <!-- The speech bubble: anchored next to the character, hides when you click elsewhere or press Esc -->
    <Border Margin="10" Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Edge}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Close (Esc)" Padding="6,0"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" Click="OnClose"/>
                <Button DockPanel.Dock="Right" Content="Data folder" ToolTip="Everything the assistant stores"
                        Padding="6,1" Margin="0,0,6,0" Click="OnOpenDataFolder"/>
                <Button DockPanel.Dock="Right" Content="Recheck" Padding="6,1" Margin="0,0,6,0" Click="OnRecheck"/>
                <TextBlock Text="Assistant" FontWeight="SemiBold" FontSize="{DynamicResource TitleSize}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Dependency status; hover for details -->
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Checking..." Foreground="{DynamicResource Muted}"
                       FontSize="{DynamicResource SmallSize}" TextWrapping="Wrap" Margin="0,6,0,8"/>

            <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Messages">
                    <!-- One template per kind of item: chat messages and weekly-review cards -->
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type local:ChatItem}">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource LabelSize}"/>
                                <!-- Read-only text box styled as plain text: mark any part of a message and copy it (Ctrl+C or right-click) -->
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="-2,2,0,0" Padding="0"
                                         Background="Transparent" BorderThickness="0" IsTabStop="False"
                                         Foreground="{DynamicResource Text}" CaretBrush="Transparent"/>

                                <!-- Copy (answers worth pasting), and after a screen or selected-text answer: the cloud, text only (asks first) -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Copy" Visibility="{Binding CopyVisibility}" Tag="{Binding}" Click="OnCopyReply"
                                            Padding="10,2" Margin="0,0,6,0" ToolTip="Copy the answer, to paste it anywhere"/>
                                    <Button Content="{Binding CloudButtonLabel}" Visibility="{Binding CloudButtonVisibility}" Tag="{Binding}"
                                            Click="OnCloudFollowUp" Padding="10,2" Margin="0,0,6,0"
                                            ToolTip="Shows you exactly what would be sent first. Nothing leaves this computer until you press Send."/>
                                    <!-- 👍/👎: saved with the question and answer in feedback\ on this computer (kept 7 days) -->
                                    <Button Content="👍" Visibility="{Binding RateVisibility}" Tag="{Binding}" Click="OnRate" Padding="5,0" Margin="0,0,2,0"
                                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}"
                                            ToolTip="Good answer"/>
                                    <Button Content="👎" Visibility="{Binding RateVisibility}" Tag="{Binding}" Click="OnRate" Padding="5,0"
                                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}"
                                            ToolTip="Bad answer. The question and the answer are saved in the feedback folder on this computer (kept 7 days), so they can be looked at."/>
                                </StackPanel>

                                <!-- What a tool did, word for word (saved or forgotten memory lines) -->
                                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Note}" FontSize="{DynamicResource SmallSize}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Choices and confirmations from actions ("Which app?", "Empty the Recycle Bin?") -->
                                <ItemsControl ItemsSource="{Binding Choices}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" IsEnabled="{Binding IsEnabled}" Tag="{Binding}" Click="OnChoice"
                                                    Padding="10,2" Margin="0,0,6,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Files found by search_files, with real paths from the index -->
                                <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,4,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}"
                                                               Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Modified, StringFormat='Modified {0:yyyy-MM-dd HH:mm}'}"
                                                               Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Content="Open" Padding="10,2" Tag="{Binding FullPath}" Click="OnOpenFile"/>
                                                        <Button Content="Show in Explorer" Padding="10,2" Margin="6,0,0,0"
                                                                Tag="{Binding FullPath}" Click="OnRevealFile"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>

                        <!-- Weekly review: edit the fact if needed, then Keep or Forget -->
                        <DataTemplate DataType="{x:Type local:ReviewItem}">
                            <Border BorderBrush="{DynamicResource ReviewEdge}" Background="{DynamicResource ReviewSurface}" BorderThickness="1" CornerRadius="6"
                                    Padding="8" Margin="0,0,4,8">
                                <StackPanel>
                                    <TextBox Text="{Binding Fact, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsOpen}"
                                             TextWrapping="Wrap" Background="Transparent" BorderThickness="0,0,0,1"
                                             Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                             ToolTip="Edit it first if it's not quite right"/>
                                    <TextBlock Text="{Binding Evidence}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding ButtonsVisibility}">
                                        <Button Content="Keep" Padding="10,2" Tag="{Binding}" Click="OnKeepFact"/>
                                        <Button Content="Forget" Padding="10,2" Margin="6,0,0,0" Tag="{Binding}" Click="OnForgetFact"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <!-- Solve with cloud chat: the text read off the screen, editable, sent only on Send -->
                        <DataTemplate DataType="{x:Type local:CloudConfirmItem}">
                            <Border BorderBrush="{DynamicResource ReviewEdge}" Background="{DynamicResource ReviewSurface}" BorderThickness="1" CornerRadius="6"
                                    Padding="8" Margin="0,0,4,8">
                                <StackPanel>
                                    <TextBlock Text="Send this to the cloud chat?" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Text="{Binding Explanation}"/>
                                    <TextBlock Text="{Binding QuestionLabel}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}"/>
                                    <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsOpen}"
                                             TextWrapping="Wrap" Background="Transparent" BorderThickness="0,0,0,1" Margin="0,0,0,6"
                                             Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"/>
                                    <TextBlock Text="{Binding TextLabel}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}"/>
                                    <TextBox Text="{Binding ScreenText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsOpen}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                             Background="Transparent" BorderThickness="0,0,0,1"
                                             Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding ButtonsVisibility}">
                                        <Button Content="Send" Padding="10,2" Tag="{Binding}" Click="OnSendToCloud"/>
                                        <Button Content="Cancel" Padding="10,2" Margin="6,0,0,0" Tag="{Binding}" Click="OnCancelCloud"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <!-- The to-do list: ticking a box saves todo.md at once -->
                        <DataTemplate DataType="{x:Type local:TodoListItem}">
                            <Border BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,4,8">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" Margin="0,3" Foreground="{DynamicResource Text}">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>

                        <!-- Help with selected text: what was picked up, and what to do with it -->
                        <DataTemplate DataType="{x:Type local:TextHelpItem}">
                            <Border BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,4,8">
                                <StackPanel>
                                    <TextBlock Text="Help with this text" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" TextWrapping="Wrap"/>
                                    <Border BorderBrush="{DynamicResource CardEdge}" BorderThickness="3,0,0,0" Padding="8,2,2,2" Margin="0,6,0,4">
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis" FontStyle="Italic"/>
                                    </Border>
                                    <TextBlock Text="{Binding Size}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding ButtonsVisibility}">
                                        <Button Content="Explain" CommandParameter="Explain" Tag="{Binding}" Click="OnTextTask" Padding="8,2" Margin="0,0,6,6"/>
                                        <Button Content="Summarise" CommandParameter="Summarise" Tag="{Binding}" Click="OnTextTask" Padding="8,2" Margin="0,0,6,6"/>
                                        <Button Content="Translate to English" CommandParameter="ToEnglish" Tag="{Binding}" Click="OnTextTask" Padding="8,2" Margin="0,0,6,6"/>
                                        <Button Content="Translate to Bulgarian" CommandParameter="ToBulgarian" Tag="{Binding}" Click="OnTextTask" Padding="8,2" Margin="0,0,6,6"/>
                                        <Button Content="Fix grammar" CommandParameter="FixGrammar" Tag="{Binding}" Click="OnTextTask" Padding="8,2" Margin="0,0,6,6"/>
                                        <Button Content="Make shorter" CommandParameter="Shorter" Tag="{Binding}" Click="OnTextTask" Padding="8,2" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <TextBlock Text="Or ask your own question about it:" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}"
                                               Visibility="{Binding ButtonsVisibility}"/>
                                    <DockPanel Margin="0,2,0,0" Visibility="{Binding ButtonsVisibility}">
                                        <Button DockPanel.Dock="Right" Content="Ask" CommandParameter="Ask" Tag="{Binding}" Click="OnTextTask" Padding="10,2" Margin="6,0,0,0"/>
                                        <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}" PreviewKeyDown="OnTextQuestionKey"
                                                 TextWrapping="Wrap" Background="Transparent" BorderThickness="0,0,0,1"
                                                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="BusyText" Grid.Row="3" Text="Thinking..." Foreground="{DynamicResource Muted}"
                       Margin="2,6,0,0" Visibility="Collapsed"/>

            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Padding="12,3"
                        Margin="6,0,0,0" IsDefault="True" Click="OnSend"/>
                <TextBox x:Name="Input" Padding="6,4" VerticalContentAlignment="Center"
                         Background="{DynamicResource InputSurface}" Foreground="{DynamicResource Text}"
                         BorderBrush="{DynamicResource Edge}" CaretBrush="{DynamicResource Text}"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
