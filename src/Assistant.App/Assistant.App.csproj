<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin WPF shell: the overlay character, its chat bubble and the tray icon. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Assistant.App</RootNamespace>
    <AssemblyName>Assistant</AssemblyName>
  </PropertyGroup>

  <!-- Keep Windows Forms names out of the global usings, or Application, MessageBox, Button
       and others become ambiguous with their WPF namesakes. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assistant.Core\Assistant.Core.csproj" />
  </ItemGroup>

</Project>
