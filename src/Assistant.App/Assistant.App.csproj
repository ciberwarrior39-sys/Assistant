<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin WPF shell: the overlay character, its chat bubble and the tray icon. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Assistant.App</RootNamespace>
    <AssemblyName>Assistant</AssemblyName>
    <!-- Velopack must run before WPF starts, so Main is written by hand in App.xaml.cs. -->
    <StartupObject>Assistant.App.App</StartupObject>
    <!-- Set by build-release.ps1 for each release. -->
    <Version>0.1.0</Version>
    <!-- The GitHub repository releases are uploaded to; empty means no update checks. Set by build-release.ps1. -->
    <UpdateRepo></UpdateRepo>
    <!-- The blob: the exe, its shortcuts and the installer use it. -->
    <ApplicationIcon>assistant.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Also inside the app, for the tray icon and the windows' icons. -->
  <ItemGroup>
    <Resource Include="assistant.ico" />
    <!-- Onest (SIL Open Font License, Fonts\OFL.txt): the app's typeface, with Latin and Cyrillic. -->
    <Resource Include="Fonts\Onest-Regular.ttf" />
    <Resource Include="Fonts\Onest-Medium.ttf" />
    <Resource Include="Fonts\Onest-SemiBold.ttf" />
  </ItemGroup>

  <!-- Keep Windows Forms names out of the global usings, or Application, MessageBox, Button
       and others become ambiguous with their WPF namesakes. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- App.xaml as a Page, so WPF doesn't generate its own Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <!-- Installer, automatic updates and uninstall (free, open source). -->
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assistant.Core\Assistant.Core.csproj" />
  </ItemGroup>

</Project>
